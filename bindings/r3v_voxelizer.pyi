# Type stubs of the Python module r3v_voxelizer (feature `python`), written by
# hand. Put this file next to r3v_voxelizer.so for type checkers and IDEs. The
# documentation stays in the module: help(r3v_voxelizer).
#
# The stubs describe the module built with every voxelizer feature: without
# single_threaded, multi_threaded or wgpu it lacks SingleThreaded,
# MultiThreaded or WgpuAccelerated.
#
# The stub_matches_module test in tests/python/voxelizer_tests.py checks that
# the classes, members and parameters here match the module. Nothing checks
# the types: keep them in line with src/bindings/python.rs by hand.

from collections.abc import Sequence
from typing import final

# ---------------------------------------------------------------- geometry

@final
class PointF:
    def __new__(cls, x: float, y: float, z: float, i: float) -> PointF: ...
    def x(self) -> float: ...
    def set_x(self, x: float) -> None: ...
    def y(self) -> float: ...
    def set_y(self, y: float) -> None: ...
    def z(self) -> float: ...
    def set_z(self, z: float) -> None: ...
    def i(self) -> float: ...
    def set_i(self, i: float) -> None: ...

@final
class PointI:
    def __new__(cls, x: int, y: int, z: int, i: int) -> PointI: ...
    def x(self) -> int: ...
    def set_x(self, x: int) -> None: ...
    def y(self) -> int: ...
    def set_y(self, y: int) -> None: ...
    def z(self) -> int: ...
    def set_z(self, z: int) -> None: ...
    def i(self) -> int: ...
    def set_i(self, i: int) -> None: ...

@final
class Multipliers:
    def __new__(cls, intensity: float, hit: int, target: int) -> Multipliers: ...
    def intensity(self) -> float: ...
    def set_intensity(self, intensity: float) -> None: ...
    def hit(self) -> int: ...
    def set_hit(self, hit: int) -> None: ...
    def target(self) -> int: ...
    def set_target(self, target: int) -> None: ...

# -------------------------------------------------------------- voxelizers

# Feature single_threaded.
@final
class SingleThreaded:
    def __new__(
        cls,
        resolution: float,
        intensity_multiplier: float,
        hit_multiplier: int,
        target_multiplier: int,
        destroy_threshold: int,
        construct_threshold: int,
        max_value: int,
        compress: bool,
    ) -> SingleThreaded: ...
    def add_points(self, sensor_pos: PointF, points: Sequence[PointF]) -> list[PointI]: ...
    def set_multipliers(self, multipliers: Multipliers) -> None: ...
    def get_multipliers(self) -> Multipliers: ...

# Feature multi_threaded.
@final
class MultiThreaded:
    def __new__(
